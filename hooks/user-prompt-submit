#!/usr/bin/env bash
# UserPromptSubmit hook for the TBaguette plugin.
#
# Re-asserts using-tbaguette's standing rule once per user turn.
#
# Why this exists alongside the SessionStart hook: SessionStart injects
# using-tbaguette's full text, but it does that exactly once, at position
# zero of the context. Measured across real sessions, that single injection
# decays badly -- sessions running hundreds of turns would invoke one
# TBaguette skill, or none, despite the notice being present and explicit
# about applying "for the rest of this conversation."
#
# So this hook trades a small per-turn token cost for the reminder actually
# staying in force. It deliberately does NOT repeat the whole SKILL.md --
# SessionStart already did that, and every TBaguette skill's trigger
# description is already in the available-skills context. All this needs to
# do is put the check back in front of the model before it starts responding.
#
# Usage: user-prompt-submit [claude|copilot|vscode]
#
# The nudge is nearly the same text in all three; the delivery is not,
# because the harnesses offer different doors. Claude Code's UserPromptSubmit
# takes additionalContext, which lands beside the prompt and leaves it alone.
# Copilot CLI's userPromptSubmitted takes only modifiedPrompt -- there is no
# additionalContext on that event -- so the only way in is to hand back the
# user's own prompt with the nudge prepended.
#
# That difference is why the copilot branch is written the way it is. Claude
# Code's path cannot damage anything: it adds a field and the prompt is
# untouched. Copilot's path is holding the user's prompt in its hands, and a
# parse that goes wrong there does not degrade the nudge, it corrupts what
# the user actually typed. So every failure in that branch -- no stdin, no
# JSON runtime, malformed input, a payload with no string prompt -- exits 0
# with an empty object, which Copilot reads as "no modification." A missing
# nudge costs one turn's reminder. A mangled prompt costs the turn.
#
# cursor is the odd one out, and not by choice. Cursor has a per-prompt hook,
# beforeSubmitPrompt, and its output schema is {continue, user_message} --
# `continue` gates the turn and `user_message` is addressed to the human. There
# is no door to the model there at all. Only two Cursor events accept
# additional_context: sessionStart, which is the injection that already decays,
# and postToolUse. So on Cursor this script rides postToolUse, which fires per
# tool result rather than per turn -- far too often to emit on every one, so it
# throttles itself per conversation and speaks up every NUDGE_EVERY-th call.
#
# That is a different cadence, not a worse one. The decay this exists to fix
# happens in long agentic runs, and long agentic runs are made of tool calls;
# a run that never calls a tool is a run short enough for the session-start
# injection to still be in view. Cursor's own docs are the record for all of
# this -- see PORTING.md.
#
# vscode is the third combination and exists because VS Code is documented
# for neither. It names the event Claude Code's way (UserPromptSubmit) and
# runs Copilot's engine, and nothing published says which output it reads.
# Unlike session-start -- where emitting both shapes is free -- emitting both
# here would mean a reader honoring both gets the nudge twice AND has the
# prompt rewritten. So vscode takes only the non-destructive shape. If that
# guess is wrong the nudge is lost, which is the same cost every failure
# path here already pays, and never the user's prompt.

set -euo pipefail

OUTPUT_FORMAT="${1:-claude}"

# How many Cursor postToolUse calls pass between re-assertions. Small enough
# that a long run is reminded several times, large enough that it is not paying
# for the nudge on every file read.
NUDGE_EVERY=10

nudge="Before responding: does a TBaguette skill cover this turn? Questions and \"too small to bother\" count -- see TBaguette:using-tbaguette. If one plausibly applies, invoke it -- Skill tool, \`TBaguette:<skill-name>\`. Triggers are already in your available-skills list; drop the skill if it does not fit once you are in it."

# Same nudge, minus the tool that does not exist here. Copilot -- CLI and VS
# Code alike -- reaches a skill by description match or by the
# /TBaguette:<skill-name> slash command.
copilot_nudge="Before responding: does a TBaguette skill cover this turn? Questions and \"too small to bother\" count -- see TBaguette:using-tbaguette. If one plausibly applies, invoke it as \`/TBaguette:<skill-name>\`. Triggers are already in your available-skills list; drop the skill if it does not fit once you are in it."

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

if [ "$OUTPUT_FORMAT" = "copilot" ]; then
    # No stdin to read means no prompt to rebuild. Emitting the empty object
    # is the whole recovery -- never guess at a prompt.
    if [ -t 0 ]; then
        printf '{}\n'
        exit 0
    fi

    payload=$(cat)

    TBAGUETTE_NUDGE="<TBAGUETTE_SKILL_CHECK>
${copilot_nudge}
</TBAGUETTE_SKILL_CHECK>"
    export TBAGUETTE_NUDGE

    # node first: Copilot CLI ships as an npm package, so a Node runtime is
    # the one interpreter that is certainly on a machine running it. python3
    # is the fallback for anywhere that stops being true. Output is captured
    # whole and only printed once it exists, so a runtime that dies halfway
    # cannot leave half a JSON object on stdout ahead of the fallback's.
    out=""
    if command -v node >/dev/null 2>&1; then
        out=$(printf '%s' "$payload" | node -e '
const fs = require("fs");
let out = "{}";
try {
  const input = JSON.parse(fs.readFileSync(0, "utf8"));
  if (typeof input.prompt === "string") {
    out = JSON.stringify({ modifiedPrompt: process.env.TBAGUETTE_NUDGE + "\n\n" + input.prompt });
  }
} catch (e) {}
process.stdout.write(out);
' 2>/dev/null) || out=""
    fi

    if [ -z "$out" ] && command -v python3 >/dev/null 2>&1; then
        out=$(printf '%s' "$payload" | python3 -c '
import json, os, sys
out = "{}"
try:
    data = json.loads(sys.stdin.read())
    prompt = data.get("prompt")
    if isinstance(prompt, str):
        out = json.dumps({"modifiedPrompt": os.environ["TBAGUETTE_NUDGE"] + "\n\n" + prompt})
except Exception:
    pass
sys.stdout.write(out)
' 2>/dev/null) || out=""
    fi

    [ -n "$out" ] || out='{}'
    printf '%s\n' "$out"
    exit 0
fi

if [ "$OUTPUT_FORMAT" = "vscode" ]; then
    nudge="$copilot_nudge"
fi

if [ "$OUTPUT_FORMAT" = "cursor" ]; then
    # Nothing on stdin means no conversation to count against. Stay quiet
    # rather than guess -- a nudge is not worth a wrong one.
    if [ -t 0 ]; then
        printf '{}\n'
        exit 0
    fi
    payload=$(cat)

    conversation_id=""
    if command -v node >/dev/null 2>&1; then
        conversation_id=$(printf '%s' "$payload" | node -e '
const fs = require("fs");
try {
  const input = JSON.parse(fs.readFileSync(0, "utf8"));
  const id = input.conversation_id;
  process.stdout.write(typeof id === "string" ? id : "");
} catch (e) {}
' 2>/dev/null) || conversation_id=""
    fi
    if [ -z "$conversation_id" ] && command -v python3 >/dev/null 2>&1; then
        conversation_id=$(printf '%s' "$payload" | python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read())
    cid = data.get("conversation_id")
    sys.stdout.write(cid if isinstance(cid, str) else "")
except Exception:
    pass
' 2>/dev/null) || conversation_id=""
    fi
    # No id is survivable: every conversation then shares one counter, so the
    # nudge still lands periodically, just not per-conversation. Silence would
    # be the worse failure.
    [ -n "$conversation_id" ] || conversation_id="shared"

    # A conversation id from the harness is untrusted input as far as the
    # filesystem is concerned -- everything outside this set becomes an
    # underscore, so it can never climb out of the state directory.
    key=$(printf '%s' "$conversation_id" | tr -c 'A-Za-z0-9_.-' '_' | cut -c1-64)
    state_dir="${TMPDIR:-/tmp}/tbaguette-nudge"
    mkdir -p "$state_dir" 2>/dev/null || true
    state_file="$state_dir/$key"

    count=$(cat "$state_file" 2>/dev/null || printf '0')
    case "$count" in ''|*[!0-9]*) count=0 ;; esac
    count=$((count + 1))
    printf '%s' "$count" > "$state_file" 2>/dev/null || true

    # First call of a conversation, then every NUDGE_EVERY-th. If the counter
    # could not be written the count stays 1 every time, which re-asserts on
    # every tool call -- noisy, but never silent, and that is the right way
    # round for a reminder.
    if [ "$count" -ne 1 ] && [ $((count % NUDGE_EVERY)) -ne 0 ]; then
        printf '{}\n'
        exit 0
    fi

    printf '{\n  "additional_context": "<TBAGUETTE_SKILL_CHECK>\\n%s\\n</TBAGUETTE_SKILL_CHECK>"\n}\n' \
        "$(escape_for_json "$nudge")"
    exit 0
fi

context="<TBAGUETTE_SKILL_CHECK>\n$(escape_for_json "$nudge")\n</TBAGUETTE_SKILL_CHECK>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
